# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/blog_builder?schema=public"

# JWT Secret for Session Authentication (Minimum 32 characters recommended)
JWT_SECRET="your_secure_jwt_secret_key_change_in_production"

# Cloudinary Storage Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Next.js Public App URL (Optional for metadata/previews)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
